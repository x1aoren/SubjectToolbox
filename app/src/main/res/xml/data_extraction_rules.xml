<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/换机迁移规则。
  设备 SN（SharedPreferences stb_device_identity）不参与云备份，也不参与换机直传，
  避免恢复到新设备后两台设备同 SN（后台以 SN 为主键，会导致遥测/单设备开关串号）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="stb_device_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="stb_device_identity.xml" />
    </device-transfer>
</data-extraction-rules>
